// conf/snpeff.config
//
// SnpEff database build parameters for Rhodotorula mucilaginosa DH4148
// (this project's reference strain, assembly GCA_058775505.1 /
// UCR_RmucDH4148_1.0).
//
// This is NOT a Nextflow config block and it is NOT the full ~500K-line
// base snpEff.config shipped inside the snpEff distribution/container.
// It is the small custom-genome snippet that must be appended to a copy
// of that base config before running `snpEff build`, exactly the same
// shape used for the sibling project Rmuc_popgen_NRRLY2510:
//   /bigdata/stajichlab/shared/projects/Population_Genomics/Rhodotorula_mucilaginosa_NRRLY2510/pipeline/08_snpEff.sh
//   /bigdata/stajichlab/shared/projects/Population_Genomics/Rhodotorula_mucilaginosa_NRRLY2510/snpEff/snpEff.config
// (custom "# RMUC_NRRLY2510" block appended at the end of that file).
//
// DH4148 differs from the NRRLY2510 recipe in one way: this project only
// has a GTF (no GFF3), so the database must be built with `-gtf22`
// against a `genes.gtf` file, not `-gff3` against `genes.gff.gz`.
//
// ---------------------------------------------------------------------
// One-off database build recipe (run once, NOT part of the Nextflow
// pipeline - the SNPEFF_ANNOTATE process in
// modules/local/snpeff/main.nf only *runs* an already-built database,
// it does not build one):
//
//   SNPEFF_DB_DIR=/bigdata/stajichlab/shared/projects/Rhodotorula/PopGen/Rhodotorula_mucilaginosa_DH4148_ref/snpEff
//   GENOME=RmucDH4148
//   REFGENOME_DIR=/bigdata/stajichlab/shared/projects/Rhodotorula/PopGen/Rhodotorula_mucilaginosa_DH4148_ref/refgenome
//
//   mkdir -p $SNPEFF_DB_DIR/data/$GENOME
//   cp $REFGENOME_DIR/GCA_058775505.1_UCR_RmucDH4148_1.0_genomic.gtf $SNPEFF_DB_DIR/data/$GENOME/genes.gtf
//   cp $REFGENOME_DIR/GCA_058775505.1_UCR_RmucDH4148_1.0_genomic.fna $SNPEFF_DB_DIR/data/$GENOME/sequences.fa
//
//   # base config comes from inside the snpEff install/container, e.g.:
//   #   singularity exec <snpeff_container> sh -c 'cat $(dirname $(readlink -f $(which snpEff)))/../share/snpeff-*/snpEff.config'
//   cat <base snpEff.config> conf/snpeff.config > $SNPEFF_DB_DIR/snpEff.config
//
//   snpEff build -gtf22 -dataDir $SNPEFF_DB_DIR/data -c $SNPEFF_DB_DIR/snpEff.config -v $GENOME
// ---------------------------------------------------------------------

// RMUC_DH4148
RmucDH4148.genome : Rhodotorula mucilaginosa DH4148
	RmucDH4148.chromosomes : CM179485.1,CM179486.1,CM179487.1,CM179488.1,CM179489.1,CM179490.1,CM179491.1,CM179492.1,CM179493.1,CM179494.1,CM179495.1,CM179496.1,CM179497.1,CM179498.1,JBZGVR010000001.1,JBZGVR010000002.1,JBZGVR010000003.1,JBZGVR010000005.1,JBZGVR010000008.1,JBZGVR010000010.1,JBZGVR010000012.1,JBZGVR010000015.1,JBZGVR010000016.1,JBZGVR010000018.1,JBZGVR010000021.1,JBZGVR010000023.1,JBZGVR010000029.1,JBZGVR010000032.1,JBZGVR010000036.1,JBZGVR010000039.1
