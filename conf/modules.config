// conf/modules.config
//
// FINAL-REVIEW I2. Spec §5 requires every tool's container to be declared
// centrally here rather than hardcoded in each module. Before this file, all
// six containerised processes carried an absolute cluster path inline, and
// PLOIDY_CROSSCHECK carried a mutable floating Docker tag ('python:3.11-slim').
//
// ---------------------------------------------------------------------------
// Why the DEFAULT value is a local .sif/.img path, not the docker:// URL
// ---------------------------------------------------------------------------
// Every module's own comment history records the same hard-won reason: pulling
// a docker:// reference at pipeline runtime trips a singularity-ce 3.9.3 pull
// bug on this cluster (first hit in Task 8 with a mulled-container reference).
// Pre-pulled local images sidestep it entirely. Making docker:// the default
// would therefore break every real run here, so the local path stays the
// default and the upstream coordinate is recorded as a REAL config value in
// the `container_pull` profile below - not merely as a code comment, which was
// the review's specific complaint (the images were "not reconstructible by an
// automated step").
//
// A fresh clone on a non-HPCC machine runs with `-profile container_pull` and
// pulls each image from its upstream source. That is the portability path the
// review asked for.
//
// ---------------------------------------------------------------------------
// Cache root (FINAL-REVIEW I2, consolidated)
// ---------------------------------------------------------------------------
// The review reported two divergent cache roots. They are in fact ONE store:
//   /bigdata/stajichlab/shared/lib/singularity_cache -> ../singularity_cache
// is a symlink; both paths resolve to the same directory (verified identical
// inode). All paths below now use the canonical
// /bigdata/stajichlab/shared/singularity_cache spelling, matching
// singularity.cacheDir in nextflow.config, so nothing sits outside the cache
// Nextflow manages.
//
// ---------------------------------------------------------------------------
// Digest pinning: FOLLOW-UP, not done here
// ---------------------------------------------------------------------------
// Spec §5 asks for exact `@sha256:` digests. `singularity inspect --json` on
// all three local images was run and does NOT expose the upstream manifest
// digest (only base-image labels, e.g. the miniconda3 base for the bcftools
// image). Recovering the real digests needs a registry API call, which was out
// of reach in this fix round. The `docker://org/image:tag` references below are
// therefore an interim value; replacing each with `...@sha256:<digest>` is a
// tracked follow-up.
//
// As a partial integrity measure in the meantime, sha256 checksums of the
// exact local images this pipeline executes are recorded in
// assets/container_checksums.sha256 (see FINAL-REVIEW M3).

params {
    // Canonical shared image store on UCR HPCC. Override to relocate every
    // local container path at once.
    singularity_cache_dir = '/bigdata/stajichlab/shared/singularity_cache'
}

process {
    // bcftools 1.24 + samtools 1.24 + python 3.14.7
    // Upstream: docker://ghcr.io/hyphaltip/container_bcftools_samtools/bcftools_samtools:1.24
    withName: 'CUSTOM_HET_PLOIDY' {
        container = "${params.singularity_cache_dir}/bcftools_samtools-1.24.sif"
    }

    // FINAL-REVIEW I1: PLOIDY_CROSSCHECK previously used the floating mutable
    // tag 'python:3.11-slim', the one process in the branch not pinned to a
    // local image. bin/ploidy_crosscheck.py needs only the Python 3 standard
    // library (argparse/csv), so it reuses the bcftools/samtools image above,
    // which ships a working python3 - no new image to build or maintain.
    // NOTE: that image's own /etc/profile resets PATH under this project's
    // login-shell process.shell, so the module's script must prepend the conda
    // env bin dir (see modules/local/ploidy_crosscheck/main.nf).
    withName: 'PLOIDY_CROSSCHECK' {
        container = "${params.singularity_cache_dir}/bcftools_samtools-1.24.sif"
    }

    // GATK 4.5.0.0
    // Upstream: docker://broadinstitute/gatk:4.5.0.0
    // (pulled via depot.galaxyproject.org/singularity/broadinstitute/gatk:4.5.0.0)
    withName: 'GATK4_HAPLOTYPECALLER|GATK4_GENOMICSDBIMPORT|GATK4_GENOTYPEGVCFS|GATK4_HARDFILTER' {
        container = "${params.singularity_cache_dir}/depot.galaxyproject.org-singularity-broadinstitute-gatk-4.5.0.0.img"
    }

    // snpEff 5.2 + tabix 1.11 (mulled combo; the plain snpeff:5.2--hdfd78af_1
    // biocontainer has neither bgzip nor tabix, both of which this module's
    // script needs).
    // Upstream: docker://quay.io/biocontainers/mulled-v2-2fe536b56916bd1d61a6a1889eb2987d9ea0cd2f:c51b2e46bf63786b2d9a7a7d23680791163ab39a-0
    withName: 'SNPEFF_ANNOTATE' {
        container = "${params.singularity_cache_dir}/depot.galaxyproject.org-singularity-mulled-v2-2fe536b56916bd1d61a6a1889eb2987d9ea0cd2f-c51b2e46bf63786b2d9a7a7d23680791163ab39a-0.img"
    }

    // nQuire (github.com/clwgg/nQuire), git commit a990a88ef14b38f257f1a0d368ba8be1bd3d7e4b.
    // No upstream container or bioconda package exists for this tool anywhere,
    // so unlike every other container above this one has NO docker:// source -
    // it is built from source with `apptainer build --fakeroot` from
    // assets/nquire.def (ubuntu:22.04 base + system samtools + nQuire compiled
    // per its own README's htsconf/submodules/make sequence). See that file for
    // the exact recipe. Because there is no upstream registry reference, this
    // process has NO entry in the container_pull profile below - a fresh clone
    // on a non-HPCC machine must build assets/nquire.def locally first (this is
    // a real limitation of container_pull for this one process, not an
    // oversight).
    withName: 'NQUIRE' {
        container = "${params.singularity_cache_dir}/nquire-a990a88.sif"
    }
}

profiles {
    // Portable path for a clone on any machine without this cluster's shared
    // image store: pull each container from its upstream registry instead.
    // Not used on UCR HPCC (see the pull-bug note at the top of this file).
    container_pull {
        process {
            withName: 'CUSTOM_HET_PLOIDY|PLOIDY_CROSSCHECK' {
                container = 'docker://ghcr.io/hyphaltip/container_bcftools_samtools/bcftools_samtools:1.24'
            }
            withName: 'GATK4_HAPLOTYPECALLER|GATK4_GENOMICSDBIMPORT|GATK4_GENOTYPEGVCFS|GATK4_HARDFILTER' {
                container = 'docker://broadinstitute/gatk:4.5.0.0'
            }
            withName: 'SNPEFF_ANNOTATE' {
                container = 'docker://quay.io/biocontainers/mulled-v2-2fe536b56916bd1d61a6a1889eb2987d9ea0cd2f:c51b2e46bf63786b2d9a7a7d23680791163ab39a-0'
            }
        }
    }
}
