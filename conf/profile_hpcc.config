// conf/profile_hpcc.config
// Mirrors Rhodotorula_mucilaginosa_DH4148_ref/conf/profile_sarek.config conventions.
//
// FINAL-REVIEW C2: this file previously held the ONLY `params` block in the
// pipeline, so any run without `-profile hpcc` - including the README's own
// documented Phase 1 command - left every parameter, `outdir` included, null.
// The defaults now live in nextflow.config, where they apply with or without a
// profile. This file keeps only what is genuinely HPCC/launch-layout specific.

workDir       = "${launchDir}/work"
timeline.file = "${launchDir}/logs/genotype_population_timeline.html"
report.file   = "${launchDir}/logs/genotype_population_report.html"
trace.file    = "${launchDir}/logs/genotype_population_trace.txt"
dag.file      = "${launchDir}/logs/genotype_population_dag.html"

timeline.overwrite = true
report.overwrite   = true
trace.overwrite    = true
dag.overwrite      = true
