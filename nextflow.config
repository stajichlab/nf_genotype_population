manifest {
    name        = 'nf_genotype_population'
    description = 'Ploidy-aware per-strain calling, joint genotyping, and filtering for Rhodotorula population genomics'
}

// FINAL-REVIEW C2: these defaults previously lived ONLY in
// conf/profile_hpcc.config, so any run without `-profile hpcc` - including the
// README's own documented Phase 1 command - resolved params.outdir to null.
// That made PLOIDY_INFERENCE's storeDir the literal path "null/ploidy" and
// made main.nf's file(params.outdir) throw. Defaults belong here so the
// pipeline is runnable without a profile; conf/profile_hpcc.config now only
// overrides what is genuinely HPCC-specific.
params {
    cram_dir           = null   // FLAT directory of <strain>.cram/<strain>.cram.crai pairs
    reference          = null
    reference_fai      = null
    reference_dict     = null
    metadata           = null   // metadata.txt
    ploidy_overrides   = null   // human-reviewed strain,ploidy CSV (see design spec)
    // Pluggable ploidy-inference method (design spec Phase 2). Valid values:
    // 'custom_het_script' (Phase 1 default, bcftools-based allele-balance
    // heuristic) or 'nquire' (github.com/clwgg/nQuire; no haploid model, reports
    // 'unknown' rather than an invented threshold for non-diploid-confident
    // samples - see bin/nquire_ploidy.py's docstring). See
    // subworkflows/local/ploidy_inference/main.nf for the switch.
    ploidy_method      = 'custom_het_script'
    population_sets    = "${projectDir}/assets/population_sets.yaml"
    snpeff_db_dir      = null
    snpeff_genome_name = null
    // VARIANT_QC_FILTER (bin/filter_population_vcf.sh), run between
    // GATK4_HARDFILTER and SNPEFF_ANNOTATE.
    population_mode    = 'subset' // 'subset': cut YAML groups from the `all` callset; 'regenotype': joint-call each group
    output_prefix      = null   // if set, outputs are named <prefix>.<pop>.* (bash-pipeline naming)
    mask_bed           = null   // repeat + low-complexity BED; null skips masking (warned)
    qc_min_gq          = 20     // genotype -> missing if FORMAT/GQ below this
    qc_min_dp          = 5      // genotype -> missing if FORMAT/DP below this
    qc_min_ab          = 0.2    // het -> missing if one allele has > 1-qc_min_ab of allelic reads
    qc_hap_min_af      = 0.8    // haploid/hom -> missing if no allele has >= this fraction of reads
    qc_dp_max_factor   = 2      // site dropped if summed DP > factor x median site DP
    qc_max_missing     = 0.1    // site dropped if fraction of missing genotypes is above this
    qc_min_maf         = 0.05   // MAF floor for the biallelic SNP set only
    skip_tree          = false  // skip SNP_ALIGNMENT + IQTREE
    tree_max_missing   = 0      // alignment keeps SNPs with missing fraction <= this (bash pipeline used 0)
    tree_model         = 'GTR+ASC'
    tree_bootstraps    = 1000   // UFBoot and SH-aLRT replicates; 0 turns both off
    tree_ref_name      = 'reference'  // alignment row name for the reference genome
    outdir             = "${launchDir}/results"
}

executor {
    name            = 'slurm'
    queueSize       = 100
    submitRateLimit = '10/1min'
}

singularity {
    enabled      = true
    autoMounts   = true
    // FINAL-REVIEW I2: canonical cache root. The previously-used
    // '/bigdata/stajichlab/shared/lib/singularity_cache' is a SYMLINK to this
    // exact directory (verified: both resolve to inode 1403431347), so the
    // "two divergent cache roots" are one store reached by two paths. All
    // container paths in conf/modules.config now use this canonical spelling.
    cacheDir     = '/bigdata/stajichlab/shared/singularity_cache'
    envWhitelist = 'SCRATCH'
    runOptions   = '--home "$PWD"'
}

process {
    executor       = 'slurm'
    cache          = 'lenient'
    shell          = ['/bin/bash', '-l']
    clusterOptions = '-N 1 -n 1'
    // $SCRATCH is node-local NVMe shared by every job SLURM schedules on that
    // node, not something this pipeline can reserve. GATK4_GENOMICSDBIMPORT
    // hit "No space left on device" writing to $SCRATCH when other users'
    // unrelated jobs on the same node had filled it, even though this
    // pipeline's own tmp usage is small (a few GB per task). Guard against
    // that noisy-neighbor case: if $SCRATCH has under 100GB free, fall back
    // to a tmp dir under the task's own work dir (already on /bigdata)
    // instead of failing outright.
    beforeScript   = '''
        module load singularity
        AVAIL_KB=$(df --output=avail "${SCRATCH:?}" | tail -1)
        THRESHOLD_KB=$((100*1024*1024))
        if [ "$AVAIL_KB" -lt "$THRESHOLD_KB" ]; then
            FALLBACK_DIR="$PWD/tmp_fallback"
            mkdir -p "$FALLBACK_DIR"
            echo "WARNING: \$SCRATCH on $(hostname) has under 100GB free (${AVAIL_KB} KB) - falling back to $FALLBACK_DIR on /bigdata" >&2
            export TMPDIR="$FALLBACK_DIR"
        else
            export TMPDIR="${SCRATCH:?}"
        fi
        export SINGULARITYENV_TMPDIR="$TMPDIR"
        export SINGULARITYENV__JAVA_OPTIONS="-Djava.io.tmpdir=$TMPDIR"
        export SINGULARITYENV_JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=$TMPDIR"
    '''.stripIndent().trim()

    // FINAL-REVIEW I4: the cpus/memory closures below scale by task.attempt,
    // but no errorStrategy or maxRetries existed anywhere in the branch, so
    // task.attempt was always 1 and the escalation never happened. Mirrors the
    // sibling Sarek config's exact policy (this project's own
    // Rhodotorula_mucilaginosa_DH4148_ref/nextflow.config): retry only on the
    // OOM/termination-signal exit statuses, finish on anything else.
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'process_low' {
        queue  = 'short'
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = '2h'
    }
    withLabel: 'process_medium' {
        queue  = 'epyc'
        cpus   = { 6 * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = '4d'
    }
}

// FINAL-REVIEW I2: per spec §5, every tool's container is declared centrally
// here rather than hardcoded in each module.
includeConfig 'conf/modules.config'

profiles {
    hpcc {
        includeConfig 'conf/profile_hpcc.config'
    }
}
